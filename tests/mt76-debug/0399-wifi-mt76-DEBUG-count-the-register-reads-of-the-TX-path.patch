+static int mt76_rr_cost_show(struct seq_file *s, void *data)
+{
+	struct mt76_dev *dev;
+	volatile u32 *desc_word = NULL;
+	volatile u32 cached_word = 0x5a5a5a5a;
+	unsigned long flags;
+	u64 t0, t1;
+	u64 ns_reg, ns_desc = 0, ns_cached;
+	u32 reg, val = 0;
+	int i;
+
+	dev = s->private;
+	if (!mt76_is_mmio(dev))
+		return -EOPNOTSUPP;
+
+	/*
+	 * MT_INT_SOURCE_CSR:
+	 *   MT7612E (PCIe): 0x0200
+	 *   MT7603 (SoC bus): 0x4200 (MT_HIF(0x200))
+	 */
+	reg = (mt76_chip(dev) == 0x7603) ? 0x4200 : 0x0200;
+
+	for (i = 0; i < ARRAY_SIZE(dev->phy.q_tx); i++) {
+		if (dev->phy.q_tx[i] && dev->phy.q_tx[i]->desc) {
+			desc_word = (volatile u32 *)dev->phy.q_tx[i]->desc;
+			break;
+		}
+	}
+
+	/* 1. Register read */
+	local_irq_save(flags);
+	t0 = ktime_get_ns();
+	for (i = 0; i < 1000; i++)
+		val += readl(dev->mmio.regs + reg);
+	t1 = ktime_get_ns();
+	local_irq_restore(flags);
+	ns_reg = t1 - t0;
+
+	/* 2. Coherent DMA descriptor word read (uncached) */
+	if (desc_word) {
+		local_irq_save(flags);
+		t0 = ktime_get_ns();
+		for (i = 0; i < 1000; i++)
+			val += *desc_word;
+		t1 = ktime_get_ns();
+		local_irq_restore(flags);
+		ns_desc = t1 - t0;
+	}
+
+	/* 3. Cached RAM word read */
+	local_irq_save(flags);
+	t0 = ktime_get_ns();
+	for (i = 0; i < 1000; i++)
+		val += cached_word;
+	t1 = ktime_get_ns();
+	local_irq_restore(flags);
+	ns_cached = t1 - t0;
+
+	if (val == 0x12345678)
+		seq_printf(s, "# %x\n", val);
+
+	seq_printf(s, "reg %llu\n", div_u64(ns_reg, 1000));
+	if (desc_word)
+		seq_printf(s, "desc %llu\n", div_u64(ns_desc, 1000));
+	else
+		seq_puts(s, "desc 0\n");
+	seq_printf(s, "cached %llu\n", div_u64(ns_cached, 1000));
+	seq_printf(s, "reg_total_ns %llu\n", ns_reg);
+	seq_printf(s, "desc_total_ns %llu\n", ns_desc);
+	seq_printf(s, "cached_total_ns %llu\n", ns_cached);
+
+	return 0;
+}
+
+static int mt76_rr_cost_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, mt76_rr_cost_show, inode->i_private);
+}
+
+static const struct file_operations fops_rr_cost = {
+	.open = mt76_rr_cost_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
+
+static int mt76_desc_rd_cost_show(struct seq_file *s, void *data)
+{
+	struct mt76_dev *dev = s->private;
+	volatile u32 *desc_word = NULL;
+	unsigned long flags;
+	u64 t0, t1, ns_desc = 0;
+	u32 val = 0;
+	int i;
+
+	for (i = 0; i < ARRAY_SIZE(dev->phy.q_tx); i++) {
+		if (dev->phy.q_tx[i] && dev->phy.q_tx[i]->desc) {
+			desc_word = (volatile u32 *)dev->phy.q_tx[i]->desc;
+			break;
+		}
+	}
+
+	if (desc_word) {
+		local_irq_save(flags);
+		t0 = ktime_get_ns();
+		for (i = 0; i < 1000; i++)
+			val += *desc_word;
+		t1 = ktime_get_ns();
+		local_irq_restore(flags);
+		ns_desc = t1 - t0;
+	}
+
+	if (val == 0x12345678)
+		seq_printf(s, "# %x\n", val);
+
+	if (desc_word)
+		seq_printf(s, "desc %llu\n", div_u64(ns_desc, 1000));
+	else
+		seq_puts(s, "desc 0\n");
+	seq_printf(s, "desc_total_ns %llu\n", ns_desc);
+
+	return 0;
+}
+
+static int mt76_desc_rd_cost_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, mt76_desc_rd_cost_show, inode->i_private);
+}
+
+static const struct file_operations fops_desc_rd_cost = {
+	.open = mt76_desc_rd_cost_open,
+	.read = seq_read,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
