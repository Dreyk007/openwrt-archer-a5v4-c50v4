 struct dentry *
 mt76_register_debugfs_fops(struct mt76_phy *phy,
 			   const struct file_operations *ops)
@@ -120,6 +417,10 @@ mt76_register_debugfs_fops(struct mt76_phy *phy,
 		debugfs_create_blob("otp", 0400, dir, &dev->otp);
 	debugfs_create_devm_seqfile(dev->dev, "rx-queues", dir,
 				    mt76_rx_queues_read);
+	dev->tx_reads.reset_time = ktime_get_ns();
+	debugfs_create_file("tx_reads", 0600, dir, dev, &fops_tx_reads);
+	debugfs_create_file("rr_cost", 0400, dir, dev, &fops_rr_cost);
+	debugfs_create_file("desc_rd_cost", 0400, dir, dev, &fops_desc_rd_cost);
 
 	return dir;
 }
