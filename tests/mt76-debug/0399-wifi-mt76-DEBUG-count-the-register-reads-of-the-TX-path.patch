+static ssize_t
+mt76_tx_reads_write(struct file *file, const char __user *user_buf,
+		    size_t count, loff_t *ppos)
+{
+	struct seq_file *s = file->private_data;
+	struct mt76_dev *dev = s->private;
+
+	memset(&dev->tx_reads, 0, sizeof(dev->tx_reads));
+	dev->tx_reads.reset_time = ktime_get_ns();
+
+	return count;
+}
+
+static int mt76_tx_reads_open(struct inode *inode, struct file *file)
+{
+	return single_open(file, mt76_tx_reads_show, inode->i_private);
+}
+
+static const struct file_operations fops_tx_reads = {
+	.open = mt76_tx_reads_open,
+	.read = seq_read,
+	.write = mt76_tx_reads_write,
+	.llseek = seq_lseek,
+	.release = single_release,
+};
