#!/bin/sh /etc/rc.common
# Firmware update check of the Archer A5 v4 / C50 v4 build (luci-app-fwupdate): looks for a new
# GitHub release after boot and then at the interval set in /etc/config/fwupdate.

START=99
USE_PROCD=1

start_service() {
	local enabled interval

	config_load fwupdate
	config_get_bool enabled settings enabled 1
	config_get interval settings interval 24
	[ "$enabled" = 1 ] || return 0

	# the interval as an argument: procd restarts the checker only when its command changes
	procd_open_instance check
	procd_set_param command /usr/libexec/fwupdate-daemon "$interval"
	procd_set_param respawn 3600 60 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger fwupdate
}
