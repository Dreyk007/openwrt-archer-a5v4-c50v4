+	seq_printf(s, "walk_max_behind %d\n", dev->tx_reads.walk_max_behind);
+	seq_printf(s, "walk_max_ahead %d\n", dev->tx_reads.walk_max_ahead);
+	seq_printf(s, "index_behind %d\n",
+		   atomic_read(&dev->tx_reads.index_behind));
+	seq_printf(s, "index_max_behind %d\n", dev->tx_reads.index_max_behind);
+	seq_printf(s, "index_ambiguous %d\n",
+		   atomic_read(&dev->tx_reads.index_ambiguous));
+
+	seq_printf(s, "tx_napi_polls %d\n",
+		   atomic_read(&dev->tx_reads.tx_napi_polls));
+	seq_printf(s, "tx_napi_pass1_done %d\n",
+		   atomic_read(&dev->tx_reads.tx_napi_pass1_done));
+	seq_printf(s, "tx_napi_pass2_done %d\n",
+		   atomic_read(&dev->tx_reads.tx_napi_pass2_done));
+
