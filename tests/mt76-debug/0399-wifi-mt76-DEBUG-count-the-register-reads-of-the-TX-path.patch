+static inline enum mt76_tx_cleanup_qid
+mt76_get_cleanup_qid(struct mt76_dev *dev, struct mt76_queue *q)
+{
+	int i;
+
+	if (!q)
+		return MT76_CLEAN_Q_OTHER;
+
+	for (i = 0; i < ARRAY_SIZE(dev->q_mcu); i++)
+		if (dev->q_mcu[i] == q)
+			return MT76_CLEAN_Q_MCU;
+
+	for (i = 0; i < ARRAY_SIZE(dev->phys); i++) {
+		struct mt76_phy *phy = dev->phys[i];
+
+		if (!phy)
+			continue;
+		if (phy->q_tx[MT_TXQ_VO] == q)
+			return MT76_CLEAN_Q_VO;
+		if (phy->q_tx[MT_TXQ_VI] == q)
+			return MT76_CLEAN_Q_VI;
+		if (phy->q_tx[MT_TXQ_BE] == q)
+			return MT76_CLEAN_Q_BE;
+		if (phy->q_tx[MT_TXQ_BK] == q)
+			return MT76_CLEAN_Q_BK;
+		if (phy->q_tx[MT_TXQ_PSD] == q)
+			return MT76_CLEAN_Q_PSD;
+	}
+
+	return MT76_CLEAN_Q_OTHER;
+}
