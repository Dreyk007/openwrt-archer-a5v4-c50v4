#!/bin/sh /etc/rc.common
#
# Restart the WAN interfaces when the WAN switch port comes back up after losing link
# (RESEARCH.md section 18).
#
# On MT7628 (rt3050-esw, swconfig), eth0 carries the carrier of all switch ports ORed together,
# so a drop on the WAN port does not drop the carrier of eth0.2 while any LAN port has link.
# netifd and udhcpc then keep the stale lease until the next renewal. Polling the WAN switch
# port every 15 s and calling ifup when it comes back up recovers the WAN right away.
#
# Off: uci set a5v4.network=network; uci set a5v4.network.wan_watch=0; uci commit a5v4;
# /etc/init.d/a5v4-wan-watch reload

START=99
USE_PROCD=1

start_service() {
	local enabled interval link_file detected sw ports ifaces

	config_load a5v4
	config_get_bool enabled network wan_watch 1
	[ "$enabled" = 1 ] || return 0

	# Test-only options (for the QEMU bench; not for normal use):
	#   a5v4.network.wan_watch_interval  - poll interval in seconds (default 15)
	#   a5v4.network.wan_watch_link_file - file with "<port> up|down" instead of swconfig
	config_get interval network wan_watch_interval 15
	config_get link_file network wan_watch_link_file ""

	detected=$(/usr/libexec/a5v4-wan-watch detect "$link_file")
	procd_open_instance
	if [ -n "$detected" ]; then
		IFS='|' read -r sw ports ifaces <<EOF
$detected
EOF
		# Resolved arguments: procd restarts the daemon only when the config changes
		procd_set_param command /usr/libexec/a5v4-wan-watch watch \
			"$sw" "$ports" "$ifaces" "$interval" ${link_file:+"$link_file"}
	else
		# WAN is not on a switch VLAN (e.g. Wi-Fi uplink or no wan): wait without polling
		procd_set_param command /usr/libexec/a5v4-wan-watch idle
	fi
	procd_set_param respawn 3600 10 0
	procd_close_instance
}

service_triggers() {
	procd_add_reload_trigger network a5v4
}
