+	seq_printf(s, "stat_empty_reads %d\n",
+		   atomic_read(&dev->tx_reads.stat_empty_reads));
+	seq_printf(s, "stat_skb_requested %d\n",
+		   atomic_read(&dev->tx_reads.stat_skb_requested));
+	seq_printf(s, "stat_skb_matched %d\n",
+		   atomic_read(&dev->tx_reads.stat_skb_matched));
+	seq_printf(s, "stat_skb_timeouts %d\n",
+		   atomic_read(&dev->tx_reads.stat_skb_timeouts));
+	seq_printf(s, "stat_poll_complete_skipped %d\n",
+		   atomic_read(&dev->tx_reads.stat_poll_complete_skipped));
+	seq_printf(s, "stat_poll_napi_skipped %d\n",
+		   atomic_read(&dev->tx_reads.stat_poll_napi_skipped));
+
+	seq_printf(s, "tx_hang_idx_reads %d\n",
+		   atomic_read(&dev->tx_reads.tx_hang_idx_reads));
+
+	seq_printf(s, "irq_handled %d\n",
+		   atomic_read(&dev->tx_reads.irq_handled));
+
+	seq_printf(s, "mmio_rr_total %d\n",
+		   atomic_read(&dev->tx_reads.mmio_rr_total));
+
+	return 0;
+}
