[ ! -e /etc/config/wireless ] && exit 0

. /lib/functions.sh
. /lib/functions/system.sh

radio_en=%ENABLE%
[ "$radio_en" != "y" ] && exit 0

radio_enable() {
	local num=$1
	local ssid='%SSID%'
	local encryption=%ENCRYPTION%
	local key='%KEY%'
	local country='%COUNTRY%'
	local band="$( uci -q get wireless.radio$num.band )"
	uci set wireless.radio$num.disabled=0
	if [ -n "$country" ]; then
		uci set wireless.radio$num.country=$country
	fi
	# 2.4 GHz: 20 MHz on channel 1; 5 GHz: 80 MHz on channel 36, which needs no DFS
	if [ "$band" = "2g" ]; then
		uci set wireless.radio$num.channel='1'
		uci set wireless.radio$num.htmode='HT20'
	elif [ "$band" = "5g" ]; then
		uci set wireless.radio$num.channel='36'
		uci set wireless.radio$num.htmode='VHT80'
	fi
	if [ -z "$ssid" ]; then
		ssid="$( board_name | cut -d ',' -f2- )"
	fi
	ssid="$ssid-$band"
	ssid="$ssid-$num"
	ssid="$ssid$( get_mac_label | sed -r 's/://g' | tail -c 5 )"
	if [ "${#ssid}" -gt 28 ]; then
		ssid="${ssid//-ubootmod/}"
		ssid="${ssid//ubootmod/}"
	fi
	if [ "${#ssid}" -gt 28 ]; then
		ssid="${ssid//-stock/}"
		ssid="${ssid//stock/}"
	fi
	if [ "${#ssid}" -gt 28 ]; then
		ssid="${ssid//-router/}"
		ssid="${ssid//router/}"
	fi
	if [ "${#ssid}" -gt 28 ]; then
		ssid="$( echo -n "$ssid" | tail -c 28 )"
	fi
	ssid="$( echo -n "$ssid" | sed -r 's/[\.\,:]+/-/g' )"
	# The default interfaces of 25.12 carry disabled '1' of their own
	uci set wireless.default_radio$num.disabled=0
	uci set wireless.default_radio$num.ssid="$ssid"
	if [ -n "$key" ]; then
		[ -z "$encryption" ] && encryption=psk2
		# 5 GHz: WPA2/WPA3 mixed mode where hostapd has SAE, so that the clients that know WPA3
		# use it and the others keep WPA2; 2.4 GHz stays WPA2 for the oldest devices
		if [ "$band" = "5g" ] && /usr/sbin/hostapd -vsae >/dev/null 2>&1; then
			case "$encryption" in
			psk2|psk2+ccmp) encryption=sae-mixed ;;
			esac
		fi
		uci set wireless.default_radio$num.encryption=$encryption
		uci set wireless.default_radio$num.key="$key"
	fi
}

for num in 0 1; do 
	if [ "$( uci -q get wireless.radio$num.type )" != "" ]; then
		if [ "$( uci -q get wireless.default_radio$num.key )" == "" ]; then
			radio_enable $num
		fi
	fi
done
uci -q commit wireless

exit 0
