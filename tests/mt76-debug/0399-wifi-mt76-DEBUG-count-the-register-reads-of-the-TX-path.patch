+static int mt76_tx_reads_show(struct seq_file *s, void *data)
+{
+	struct mt76_dev *dev = s->private;
+	u64 now = ktime_get_ns();
+	u64 elapsed = (now >= dev->tx_reads.reset_time) ?
+		      (now - dev->tx_reads.reset_time) : 0;
+	static const char * const qnames[] = {
+		[MT76_CLEAN_Q_MCU] = "mcu",
+		[MT76_CLEAN_Q_PSD] = "psd",
+		[MT76_CLEAN_Q_BE] = "be",
+		[MT76_CLEAN_Q_BK] = "bk",
+		[MT76_CLEAN_Q_VI] = "vi",
+		[MT76_CLEAN_Q_VO] = "vo",
+		[MT76_CLEAN_Q_OTHER] = "other",
+	};
+	static const char * const callers[] = {
+		[MT76_STAT_CALLER_IRQ] = "irq",
+		[MT76_STAT_CALLER_NAPI] = "napi",
+		[MT76_STAT_CALLER_WORKER] = "worker",
+		[MT76_STAT_CALLER_TX_COMPLETE] = "tx_complete",
+	};
+	int i;
+
+	seq_printf(s, "elapsed_ns %llu\n", elapsed);
+
+	for (i = 0; i < __MT76_CLEAN_Q_MAX; i++)
+		seq_printf(s, "clean_calls_%s %d\n", qnames[i],
+			   atomic_read(&dev->tx_reads.clean_calls[i]));
+
+	for (i = 0; i < __MT76_CLEAN_Q_MAX; i++)
+		seq_printf(s, "clean_empty_%s %d\n", qnames[i],
+			   atomic_read(&dev->tx_reads.clean_empty[i]));
+
+	for (i = 0; i < __MT76_CLEAN_Q_MAX; i++)
+		seq_printf(s, "clean_skipped_%s %d\n", qnames[i],
+			   atomic_read(&dev->tx_reads.clean_skipped[i]));
+
+	for (i = 0; i < __MT76_CLEAN_Q_MAX; i++)
+		seq_printf(s, "clean_first_idx_%s %d\n", qnames[i],
+			   atomic_read(&dev->tx_reads.clean_first_idx_reads[i]));
+
+	for (i = 0; i < __MT76_CLEAN_Q_MAX; i++)
+		seq_printf(s, "clean_re_reads_%s %d\n", qnames[i],
+			   atomic_read(&dev->tx_reads.clean_re_reads[i]));
+
+	for (i = 0; i < __MT76_CLEAN_Q_MAX; i++)
+		seq_printf(s, "clean_done_%s %d\n", qnames[i],
+			   atomic_read(&dev->tx_reads.clean_done[i]));
+
+	for (i = 0; i < __MT76_CLEAN_Q_MAX; i++)
+		seq_printf(s, "clean_done_walk_%s %d\n", qnames[i],
+			   atomic_read(&dev->tx_reads.clean_done_walk[i]));
+
+	for (i = 0; i < __MT76_CLEAN_Q_MAX; i++)
+		seq_printf(s, "clean_done_idx_%s %d\n", qnames[i],
+			   atomic_read(&dev->tx_reads.clean_done_idx[i]));
+
+	for (i = 0; i < __MT76_CLEAN_Q_MAX; i++)
+		seq_printf(s, "walk_empty_%s %d\n", qnames[i],
+			   atomic_read(&dev->tx_reads.walk_empty[i]));
+
+	for (i = 0; i < __MT76_CLEAN_Q_MAX; i++)
+		seq_printf(s, "fallback_progress_%s %d\n", qnames[i],
+			   atomic_read(&dev->tx_reads.fallback_progress[i]));
+
+	for (i = 0; i < __MT76_CLEAN_Q_MAX; i++)
+		seq_printf(s, "desc_reads_%s %d\n", qnames[i],
+			   atomic_read(&dev->tx_reads.desc_reads[i]));
+
+	seq_printf(s, "shadow_missing %d\n",
+		   atomic_read(&dev->tx_reads.shadow_missing));
+	seq_printf(s, "shadow_missing_after_next %d\n",
+		   atomic_read(&dev->tx_reads.shadow_missing_after_next));
+	seq_printf(s, "shadow_ooo %d\n",
+		   atomic_read(&dev->tx_reads.shadow_ooo));
+	seq_printf(s, "shadow_unverifiable %d\n",
+		   atomic_read(&dev->tx_reads.shadow_unverifiable));
+	seq_printf(s, "shadow_missing_overflow %d\n",
+		   atomic_read(&dev->tx_reads.shadow_missing_overflow));
+	seq_printf(s, "shadow_early %d\n",
+		   atomic_read(&dev->tx_reads.shadow_early));
+	seq_printf(s, "shadow_max_gap %d\n", dev->tx_reads.shadow_max_gap);
+
+	seq_printf(s, "walk_behind %d\n",
+		   atomic_read(&dev->tx_reads.walk_behind));
+	seq_printf(s, "walk_ahead %d\n",
