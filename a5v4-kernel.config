# Kernel configuration fragment of the Archer A5 v4 / C50 v4 build.
#
# build.sh copies it to env/kernel-config, which OpenWrt merges last into the configuration of the
# target (include/target.mk). The CONFIG_KERNEL_* options of the seed and the KCONFIG of the
# selected kmod packages still override it, so an option with a CONFIG_KERNEL_* switch is set in
# the seed. build.sh checks that every line below is in the final configuration.

# Built in: every module of the kernel tree that the image loads at boot. A module takes whole
# pages of RAM and is not faster on MIPS (OpenWrt allocates modules next to the kernel and builds
# them without long calls); their kmod packages stay selected and install nothing. mac80211,
# cfg80211, mt76 and gpio-button-hotplug are built outside the kernel tree and stay modules. The
# VPNs stay modules too, loaded when a tunnel is created: WireGuard (kmod-wireguard without its
# autoload, with the MIPS assembler ChaCha20 and Poly1305 of kmod-crypto-lib-*) and AmneziaWG.

# netfilter, nftables, NAT and the flow table (kmod-nf-*, kmod-nft-*)
CONFIG_NETFILTER_NETLINK=y
CONFIG_NF_CONNTRACK=y
CONFIG_NF_DEFRAG_IPV4=y
CONFIG_NF_DEFRAG_IPV6=y
CONFIG_NF_NAT=y
CONFIG_NF_LOG_SYSLOG=y
CONFIG_NF_LOG_IPV4=y
CONFIG_NF_LOG_IPV6=y
CONFIG_NF_REJECT_IPV4=y
CONFIG_NF_REJECT_IPV6=y
CONFIG_NF_TABLES=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB=y
CONFIG_NFT_FIB_INET=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FLOW_OFFLOAD=y
CONFIG_NFT_HASH=y
CONFIG_NFT_LIMIT=y
CONFIG_NFT_LOG=y
CONFIG_NFT_MASQ=y
CONFIG_NFT_NAT=y
CONFIG_NFT_NUMGEN=y
CONFIG_NFT_QUOTA=y
CONFIG_NFT_REDIR=y
CONFIG_NFT_REJECT=y
CONFIG_NFT_REJECT_INET=y
CONFIG_NFT_REJECT_IPV4=y
CONFIG_NFT_REJECT_IPV6=y
CONFIG_NF_FLOW_TABLE=y
CONFIG_NF_FLOW_TABLE_INET=y
CONFIG_LIBCRC32C=y
# The generic configuration has it on; as a module of nf_tables no package of the image installed it
# CONFIG_NF_TABLES_BRIDGE is not set

# PPP and PPPoE (kmod-ppp, kmod-pppoe)
CONFIG_PPP=y
CONFIG_PPP_ASYNC=y
CONFIG_PPPOE=y
CONFIG_SLHC=y
CONFIG_CRC_CCITT=y

# The UDP tunnel helpers of the VPNs (kmod-udptunnel4/6 load at boot); WireGuard is a module
CONFIG_NET_UDP_TUNNEL=y
# CONFIG_WIREGUARD_DEBUG is not set

# The crypto of mac80211 (CCMP, GCMP, BIP) and of its random number generator
CONFIG_CRYPTO_CMAC=y
CONFIG_CRYPTO_CRC32C=y
CONFIG_CRYPTO_DRBG_MENU=y
CONFIG_CRYPTO_DRBG=y
CONFIG_CRYPTO_GENIV=y
CONFIG_CRYPTO_HMAC=y
CONFIG_CRYPTO_JITTERENTROPY=y
CONFIG_CRYPTO_RNG=y
CONFIG_CRYPTO_RNG_DEFAULT=y
CONFIG_CRYPTO_SEQIV=y
CONFIG_CRYPTO_SHA3=y
CONFIG_CRYPTO_SHA512=y

# LEDs (kmod-leds-gpio)
CONFIG_LEDS_GPIO=y

# Off (approved, RESEARCH.md section 10): nothing in the image uses them. Debugfs and magic SysRq
# have switches of their own in the seed (KERNEL_DEBUG_FS, PACKAGE_MAC80211_DEBUGFS,
# KERNEL_MAGIC_SYSRQ), seccomp with USE_SECCOMP. Two approved removals stay on: the xattrs of
# jffs2 and tmpfs (overlayfs keeps the opaque directories of the overlay in them) and bridge VLAN
# filtering (netifd always sets IFLA_BR_VLAN_FILTERING, and without the option the kernel refuses
# to create br-lan).
# CONFIG_BPF_SYSCALL is not set
# CONFIG_BPF_JIT is not set
# CONFIG_IP_ROUTE_MULTIPATH is not set
# CONFIG_GPIO_SYSFS is not set
# CONFIG_USB_SUPPORT is not set
# CONFIG_PHY_RALINK_USB is not set

# The kernel exports only the symbols that the modules of its own tree and the modules built
# outside it (the whitelist a5v4-ksyms.txt, a path relative to the kernel tree) take from it. Only
# the modules of this build load into it; the official kmods never could (ALL_KMODS is off).
CONFIG_TRIM_UNUSED_KSYMS=y
CONFIG_UNUSED_KSYMS_WHITELIST="../../../../a5v4-ksyms.txt"
